rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'connect.nasimul@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    // Customer Orders - Allow full operational access for store orders & CRM
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) &&
        incoming().items is list &&
        incoming().items.size() > 0 &&
        incoming().items.size() <= 50 &&
        incoming().total is number &&
        incoming().total >= 0;
      allow update: if isValidId(orderId);
      allow delete: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isAdmin();
    }

    // Customer Wishlist
    match /wishlists/{wishlistId} {
      allow read, write: if isValidId(wishlistId);
    }

    // CRM Customer Profiles & Notes
    match /crm_customers/{customerId} {
      allow read, write: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
