rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'connect.nasimul@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (isValidId(userId) && (request.auth.uid == userId || isAdmin()));
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && incoming().uid == request.auth.uid && (!('role' in incoming()) || incoming().role == 'customer' || isAdmin());
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin()) && incoming().uid == existing().uid && (!incoming().diff(existing()).affectedKeys().hasAny(['role']) || isAdmin());
      allow delete: if isAdmin();
    }

    // Customer Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) &&
        incoming().userId == request.auth.uid &&
        incoming().items is list &&
        incoming().items.size() > 0 &&
        incoming().items.size() <= 50 &&
        incoming().total is number &&
        incoming().total >= 0;
      allow update: if isSignedIn() && isValidId(orderId) && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // Customer Wishlist
    match /wishlists/{wishlistId} {
      allow get: if isSignedIn() && isValidId(wishlistId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(wishlistId) && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(wishlistId) && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
