{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 512 },
        "division": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["customer", "admin"], "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer e-commerce order details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "deliveryAddress": { "type": "string", "maxLength": 512 },
        "division": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 64 },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "paymentStatus": { "type": "string", "maxLength": 32 },
        "transactionId": { "type": "string", "maxLength": 128 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 500 },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "riderName": { "type": "string", "maxLength": 128 },
        "riderPhone": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "customerName", "customerPhone", "deliveryAddress", "items", "total", "status"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Customer wishlist saved items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "productId"]
    },
    "CustomerCrmProfile": {
      "title": "CustomerCrmProfile",
      "description": "CRM customer notes, tags and VIP status managed by admins",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "tags": { "type": "array" },
        "notes": { "type": "string", "maxLength": 1000 },
        "tier": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerEmail"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection indexed by userId"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer e-commerce orders"
    },
    "/wishlists/{wishlistId}": {
      "schema": "WishlistItem",
      "description": "Customer saved product bookmarks"
    },
    "/crm_customers/{customerId}": {
      "schema": "CustomerCrmProfile",
      "description": "CRM customer profiles and notes for admins"
    }
  }
}
